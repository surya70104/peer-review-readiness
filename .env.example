# Copy this file to .env and set your own password. Never commit .env.
#
# The only setting the app reads. The database is created for you if it does not
# exist (scripts/migrate.py connects to the default "postgres" database first).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/oak_peer_review

# Informational: scripts/run.ps1 serves on 127.0.0.1:8015. To use another port, start
# uvicorn yourself:  .\.venv\Scripts\python -m uvicorn app.main:app --port 8016
HOST=127.0.0.1
PORT=8015
